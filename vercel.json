{
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://registre-cancer-backend.onrender.com/api/:path*"
    },
    {
      "source": "/admin/:path*",
      "destination": "https://registre-cancer-backend.onrender.com/admin/:path*"
    },
    {
      "source": "/static/admin/:path*",
      "destination": "https://registre-cancer-backend.onrender.com/static/admin/:path*"
    },
    {
      "source": "/((?!api|admin|static/admin).*)",
      "destination": "/index.html"
    }
  ]
}
